---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="About | Venera Capital"
	description="Venera Capital is a private equity firm built on deep Kazakhstan expertise and global investment discipline."
>

	<!-- ── Page Hero ─────────────────────────────────────────────── -->
	<section class="page-hero bg-navy">
		<div class="container">
			<span class="section-eyebrow">About the Firm</span>
			<h1 style="color:var(--white); font-weight:300; margin-bottom:0;">Who We Are</h1>
			<hr class="divider" />
		</div>
	</section>

	<!-- ── Overview ──────────────────────────────────────────────── -->
	<section class="section bg-white">
		<div class="container">
			<div class="overview-grid">
				<div class="overview-main">
					<span class="section-eyebrow">Overview</span>
					<h2>A Private Equity Firm Built for Kazakhstan</h2>
					<hr class="divider" />
					<p class="lead">
						Venera Capital is a private equity firm dedicated to identifying, investing in, and building exceptional businesses across Kazakhstan and Central Asia — combining global investment discipline with deep regional expertise.
					</p>
					<p style="color:var(--text-mid);">
						Our team brings together professionals from McKinsey's Private Equity Practice and leading international financial institutions, alongside operators with 20+ years of on-the-ground M&A, IFRS finance, and energy and infrastructure experience in Kazakhstan. This rare combination of institutional rigour and local knowledge allows us to source and execute opportunities that are inaccessible to most international investors.
					</p>
					<p style="color:var(--text-mid);">
						We believe Kazakhstan represents one of the world's most compelling investment opportunities — a resource-rich economy undergoing genuine reform, with a young and growing population and governments actively welcoming sophisticated private capital. Venera Capital is uniquely positioned to help investors access these opportunities.
					</p>
				</div>
				<div class="overview-sidebar">
					<div class="sidebar-item">
						<h5>Headquarters</h5>
						<p>Astana, Kazakhstan</p>
					</div>
					<div class="sidebar-item">
						<h5>Investment Region</h5>
						<p>Kazakhstan primary; Uzbekistan and broader Central Asia selectively</p>
					</div>
					<div class="sidebar-item">
						<h5>Strategy</h5>
						<p>Control and co-control investments in growth-stage and established businesses across key sectors</p>
					</div>
					<div class="sidebar-item">
						<h5>Sectors</h5>
						<p>Energy, Metals Processing, Mining, Food Production, Construction, Financial Services</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ── Reasons to Engage ─────────────────────────────────────── -->
	<section class="section bg-off-white">
		<div class="container">
			<div class="section-header-centered">
				<span class="section-eyebrow">Why Partner With Us</span>
				<h2>Reasons to Engage with Venera Capital</h2>
				<hr class="divider divider-center" />
			</div>
			<div class="engage-list">

				<div class="engage-row">
					<div class="engage-label">
						<span class="e-num">01</span>
						<h4>Experienced Local Investment Team</h4>
					</div>
					<div class="engage-body">
						<ul>
							<li>Senior manager from McKinsey's Private Equity Practice with deep Kazakhstan transaction experience</li>
							<li>M&A professional with 20+ years executing deals across Kazakhstan and the wider CIS</li>
							<li>Finance expert with IFRS and international audit credentials across multiple sectors</li>
							<li>Energy and infrastructure executive with operating and investment experience in the region</li>
							<li>Sector-specific industry experts embedded across target verticals</li>
						</ul>
					</div>
				</div>

				<div class="engage-row">
					<div class="engage-label">
						<span class="e-num">02</span>
						<h4>Robust Investment Processes &amp; Governance</h4>
					</div>
					<div class="engage-body">
						<ul>
							<li>Institutional-grade investment processes: IC approvals, independent valuation, structured due diligence</li>
							<li>ESG integration across the full investment lifecycle — from screening through exit</li>
							<li>Independent governance frameworks aligned with international LP expectations</li>
							<li>Transparent reporting and portfolio monitoring against agreed KPIs</li>
						</ul>
					</div>
				</div>

				<div class="engage-row">
					<div class="engage-label">
						<span class="e-num">03</span>
						<h4>Access to Quality Pipeline &amp; Strategic Resources</h4>
					</div>
					<div class="engage-body">
						<ul>
							<li>Proprietary access to a deep pool of mid-market transactions not marketed to international investors</li>
							<li>Exclusive investment pipeline through the Development Bank of Kazakhstan — with two active joint investments already completed</li>
							<li>Strong relationships with government ministries, SOEs, and leading private business families</li>
							<li>In-house operational talent available to deploy into portfolio companies</li>
						</ul>
					</div>
				</div>

				<div class="engage-row">
					<div class="engage-label">
						<span class="e-num">04</span>
						<h4>Favourable Market Conditions</h4>
					</div>
					<div class="engage-body">
						<ul>
							<li>Stable macroeconomic environment: current-account surplus, substantial FX reserves, manageable public debt</li>
							<li>Pro-reform government actively encouraging private investment and improving the regulatory environment</li>
							<li>Kazakhstan ranked among the top investable markets in the region by international indices</li>
							<li>Import-substitution dynamics and supply-chain on-shoring creating structural tailwinds across our target sectors</li>
						</ul>
					</div>
				</div>

			</div>
		</div>
	</section>

	<!-- ── Philosophy ────────────────────────────────────────────── -->
	<section class="section bg-white">
		<div class="container">
			<div class="section-header-centered">
				<span class="section-eyebrow">Investment Philosophy</span>
				<h2>Our Guiding Principles</h2>
				<hr class="divider divider-center" />
			</div>
			<div class="principles-grid">
				<div class="principle-card">
					<div class="p-header">
						<span class="p-num">01</span>
						<h3>Long-Term Value Creation</h3>
					</div>
					<p>We invest with a multi-year horizon, refusing to sacrifice sustainable growth for short-term financial engineering. Our portfolio companies benefit from a patient capital partner that measures success in the strength of businesses built, not just returns generated.</p>
				</div>
				<div class="principle-card">
					<div class="p-header">
						<span class="p-num">02</span>
						<h3>Operational Partnership</h3>
					</div>
					<p>We are active investors. Our team works alongside management to identify strategic opportunities, strengthen operations, and build the organisational capabilities required for sustained competitive advantage. We bring both capital and expertise to every investment.</p>
				</div>
				<div class="principle-card">
					<div class="p-header">
						<span class="p-num">03</span>
						<h3>Regional Expertise</h3>
					</div>
					<p>Kazakhstan has its own unique dynamics — regulatory frameworks, business cultures, and market structures that differ meaningfully from other emerging markets. Our deep regional knowledge and established relationships allow us to navigate these complexities and turn them into advantages.</p>
				</div>
				<div class="principle-card">
					<div class="p-header">
						<span class="p-num">04</span>
						<h3>Responsible Investing</h3>
					</div>
					<p>We are committed to building businesses that create value not just for our investors, but for the communities and economies in which they operate. Environmental, social, and governance considerations are integrated into our investment process and portfolio management.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ── Why Kazakhstan ────────────────────────────────────────── -->
	<section class="section bg-navy">
		<div class="container">
			<div class="region-grid">
				<div class="region-text">
					<span class="section-eyebrow">The Opportunity</span>
					<h2 style="color:var(--white); font-weight:300;">Why Kazakhstan</h2>
					<hr class="divider" />
					<p style="color:rgba(255,255,255,0.65);">
						Kazakhstan is Central Asia's largest economy — a nation of 19 million people projected to grow to 26 million by 2050 — with a young median age below 30, abundant natural resources, and one of the most reform-minded governments in the region.
					</p>
					<p style="color:rgba(255,255,255,0.65);">
						The country's landlocked position, far from having limited its development, is driving a structural import-substitution dynamic: businesses that process raw materials domestically, reduce reliance on imported goods, and serve a growing urban consumer base have structural advantages that compound over time.
					</p>
					<a href="/focus" class="btn btn-primary" style="margin-top:1.25rem;">Explore Our Investment Focus</a>
				</div>
				<div class="region-factors">
					<div class="factor">
						<div class="f-arrow">→</div>
						<div>
							<h5 style="color:var(--white);">Resource Endowment</h5>
							<p>Top global rankings in oil, gas, uranium, gold, copper, chrome, manganese, zinc, and lead</p>
						</div>
					</div>
					<div class="factor">
						<div class="f-arrow">→</div>
						<div>
							<h5 style="color:var(--white);">Population Growth</h5>
							<p>19 million today → 26 million+ by 2050; median age under 30; rapidly urbanising</p>
						</div>
					</div>
					<div class="factor">
						<div class="f-arrow">→</div>
						<div>
							<h5 style="color:var(--white);">Macro Stability</h5>
							<p>Current-account surplus, substantial FX reserves, manageable public debt, stable currency regime</p>
						</div>
					</div>
					<div class="factor">
						<div class="f-arrow">→</div>
						<div>
							<h5 style="color:var(--white);">Pro-Investment Reforms</h5>
							<p>Active liberalisation, rule-of-law improvements, and an open stance towards private and foreign capital</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ── Contact CTA ───────────────────────────────────────────── -->
	<section class="section-sm bg-white">
		<div class="container" style="text-align:center; max-width:600px;">
			<span class="section-eyebrow">Work With Us</span>
			<h2>Ready to Connect?</h2>
			<hr class="divider divider-center" />
			<p style="color:var(--text-mid); margin-bottom:2rem;">
				We welcome enquiries from investors, management teams, and businesses across the region.
			</p>
			<a href="/contact" class="btn btn-primary">Contact Venera Capital</a>
		</div>
	</section>

</Layout>

<style>
	.lead {
		font-size: 1.1rem;
		line-height: 1.8;
		color: var(--text-dark);
	}

	.overview-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 5rem;
		align-items: start;
	}

	.overview-sidebar {
		border-left: 1px solid var(--border);
		padding-left: 3rem;
		display: flex;
		flex-direction: column;
		gap: 2.25rem;
	}

	.sidebar-item h5  { color: var(--gold); margin-bottom: 0.4rem; }
	.sidebar-item p   { font-size: 0.875rem; color: var(--text-mid); line-height: 1.65; margin: 0; }

	/* Reasons to Engage */
	.engage-list {
		display: flex;
		flex-direction: column;
		border-top: 1.5px solid var(--border);
	}

	.engage-row {
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: 4rem;
		padding: 3rem 0;
		border-bottom: 1px solid var(--border);
		align-items: start;
	}

	.engage-label {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.e-num {
		font-family: var(--font-serif);
		font-size: 2rem;
		font-weight: 300;
		color: var(--gold);
		opacity: 0.4;
		line-height: 1;
	}

	.engage-label h4 {
		font-family: var(--font-sans);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--navy);
		margin: 0;
		line-height: 1.5;
	}

	.engage-body ul {
		margin: 0;
		padding-left: 1.25em;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.engage-body li {
		font-size: 0.92rem;
		color: var(--text-mid);
		line-height: 1.65;
	}

	/* Principles */
	.principles-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5px;
		background: var(--border);
		border: 1.5px solid var(--border);
	}

	.principle-card {
		background: var(--white);
		padding: 2.75rem 2.25rem;
		transition: background var(--transition);
	}

	.principle-card:hover { background: var(--off-white); }

	.p-header {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.p-num {
		font-family: var(--font-serif);
		font-size: 2.5rem;
		font-weight: 300;
		color: var(--gold);
		opacity: 0.35;
		line-height: 1;
		flex-shrink: 0;
	}

	.principle-card h3 { font-size: 1.3rem; font-weight: 500; margin: 0; }
	.principle-card p  { font-size: 0.92rem; color: var(--text-mid); line-height: 1.72; margin: 0; }

	.region-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 5rem;
		align-items: start;
	}

	.region-factors {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.factor { display: flex; gap: 1.25rem; align-items: flex-start; }

	.f-arrow {
		font-size: 1rem;
		color: var(--gold);
		flex-shrink: 0;
		margin-top: 0.05rem;
	}

	.factor p {
		font-size: 0.85rem;
		color: rgba(255,255,255,0.52);
		margin: 0.25rem 0 0;
		line-height: 1.6;
	}

	@media (max-width: 900px) {
		.overview-grid,
		.region-grid    { grid-template-columns: 1fr; gap: 2.5rem; }
		.principles-grid { grid-template-columns: 1fr; }
		.overview-sidebar {
			border-left: none;
			padding-left: 0;
			border-top: 1px solid var(--border);
			padding-top: 2.5rem;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
		.engage-row {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}

	@media (max-width: 600px) {
		.overview-sidebar { grid-template-columns: 1fr; }
	}
</style>
